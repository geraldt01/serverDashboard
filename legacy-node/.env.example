PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:4000
DB_PATH=./data/dashboard.db

# AWS monitoring settings
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set to true to allow seeded mock data when cloud integration is unavailable
ENABLE_MOCK_MONITORING=true
